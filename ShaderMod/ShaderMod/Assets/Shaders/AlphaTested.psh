#ifdef GLSL

// ShaderMod：地形（不透明 / 镂空）片元着色器，BSL 风格。
// - 用屏幕空间导数重建面法线（方块都是平面，结果精确）；
// - 向阳面暖色、背阴面冷色，按白天强度、雨量、太阳高度调节；轻微提高饱和度；
// - 保留原版雾；最终结果按 u_shaderStrength 与原版结果混合（0 = 与原版完全一致）。
// 不支持导数扩展的设备会自动跳过方向光，只保留调色。

#ifdef GL_OES_standard_derivatives
#extension GL_OES_standard_derivatives : enable
#endif

// <Sampler Name='u_samplerState' Texture='u_texture' />

#ifdef GL_ES
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
#endif

uniform sampler2D u_texture;
uniform vec3 u_fogColor;
#ifdef ALPHATESTED
uniform float u_alphaThreshold;
#endif

// ShaderMod 参数（未设置时为 0 → 原版画面）
uniform float u_shaderStrength;
uniform vec3 u_sunDirection;
uniform float u_daylight;
uniform float u_rain;

varying vec4 v_color;
varying vec2 v_texcoord;
varying float v_fog;
varying vec3 v_relativePosition;
varying vec3 v_toCamera;

const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

vec3 enhance(vec3 baseColor)
{
	float sunHeight = u_sunDirection.y;
	// 白天、没下雨、太阳在地平线以上时，方向光才明显
	float sunVisibility = clamp(u_daylight, 0.0, 1.0) * (1.0 - 0.7 * clamp(u_rain, 0.0, 1.0)) * clamp(sunHeight * 5.0 + 0.3, 0.0, 1.0);
	// 顶点色即烘焙光照：暗处（洞穴、室内）不加阳光冷暖色
	float vertexLight = max(v_color.r, max(v_color.g, v_color.b));
	sunVisibility *= smoothstep(0.25, 0.7, vertexLight);

	vec3 tint = vec3(1.0);
#ifdef GL_OES_standard_derivatives
	vec3 normal = normalize(cross(dFdx(v_relativePosition), dFdy(v_relativePosition)));
	// 可见面总是朝向相机，据此统一法线方向（不受渲染到纹理时的 y 翻转影响）
	if (dot(normal, v_toCamera) < 0.0)
	{
		normal = -normal;
	}
	float lambert = max(dot(normal, u_sunDirection), 0.0);
	// 太阳越低越偏橙（日出日落），正午偏柔和的暖白
	vec3 warm = mix(vec3(1.24, 0.98, 0.76), vec3(1.14, 1.06, 0.92), clamp(sunHeight * 3.0, 0.0, 1.0));
	vec3 cool = vec3(0.84, 0.91, 1.07);
	tint = mix(vec3(1.0), mix(cool, warm, lambert), sunVisibility);
#endif

	vec3 color = baseColor * tint;
	// BSL 式鲜艳：提高饱和度
	float luma = dot(color, LUMA);
	color = mix(vec3(luma), color, 1.12);
	return max(color, vec3(0.0));
}

void main()
{
	vec4 result = v_color * texture2D(u_texture, v_texcoord);

#ifdef ALPHATESTED
	if (result.a <= u_alphaThreshold)
		discard;
#endif

	vec3 fogColor = u_fogColor * v_color.a;
	vec3 vanilla = mix(result.rgb, fogColor, v_fog);

	vec3 enhanced = vanilla;
	if (u_shaderStrength > 0.0)
	{
		enhanced = mix(enhance(result.rgb), fogColor, v_fog);
	}

	gl_FragColor = vec4(mix(vanilla, enhanced, clamp(u_shaderStrength, 0.0, 1.0)), result.a);
}

#endif
