#ifdef GLSL

// ShaderMod：半透明地形片元着色器。
// 与原版相同，另有两个参数（未设置时都为 0，画面与原版一致）：
// - u_vanillaFogOff：关闭原版距离雾；
// - u_hideWater：不画水（水面由光影管线在后处理中重新绘制：反射、折射、波浪、水下雾）。
//   水按贴图格识别：u_waterSlots 最多 4 个格号（地形图集 16×16 格），-1 表示未用。

// <Sampler Name='u_samplerState' Texture='u_texture' />

#ifdef GL_ES
precision mediump float;
#endif

uniform sampler2D u_texture;
uniform vec3 u_fogColor;
uniform float u_vanillaFogOff;
uniform float u_hideWater;
uniform vec4 u_waterSlots;

varying vec4 v_color;
varying vec2 v_texcoord;
varying float v_fog;

bool isWater()
{
	vec2 cell = floor(v_texcoord * 16.0);
	float slot = cell.x + cell.y * 16.0;
	vec4 d = abs(u_waterSlots - vec4(slot));
	return min(min(d.x, d.y), min(d.z, d.w)) < 0.5;
}

void main()
{
	if (u_hideWater > 0.5 && isWater())
		discard;

	vec4 result = v_color;
	result *= texture2D(u_texture, v_texcoord);

	vec4 premultipliedFogColor = vec4(u_fogColor * result.a, result.a);
	result = mix(result, premultipliedFogColor, v_fog * (1.0 - u_vanillaFogOff));

	gl_FragColor = result;
}

#endif
