#ifdef GLSL

// ShaderMod：地形（不透明 / 镂空）片元着色器。
// 与原版相同，只多一个 u_vanillaFogOff：光影管线开启时为 1，关闭原版距离雾（改由 Derivative 的大气散射和边界雾处理）。
// 未设置时为 0，画面与原版完全一致。

// <Sampler Name='u_samplerState' Texture='u_texture' />

#ifdef GL_ES
precision mediump float;
#endif

uniform sampler2D u_texture;
uniform vec3 u_fogColor;
#ifdef ALPHATESTED
uniform float u_alphaThreshold;
#endif
uniform float u_vanillaFogOff;

varying vec4 v_color;
varying vec2 v_texcoord;
varying float v_fog;

void main()
{
	vec4 result = v_color;
	result *= texture2D(u_texture, v_texcoord);

#ifdef ALPHATESTED
	if (result.a <= u_alphaThreshold)
		discard;
#endif

	float fog = v_fog * (1.0 - u_vanillaFogOff);
	result.rgb = mix(result.rgb, u_fogColor * v_color.a, fog);

	gl_FragColor = result;
}

#endif
