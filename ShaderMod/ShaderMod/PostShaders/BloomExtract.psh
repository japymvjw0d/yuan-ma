// ShaderMod 后处理：提取亮部并降采样（4 点平均降低闪烁），带柔和阈值。

// <Sampler Name='u_samplerState' Texture='u_texture' />

#ifdef GL_ES
precision mediump float;
#endif

uniform sampler2D u_texture;
uniform vec2 u_sourceTexelSize;
uniform float u_threshold;
uniform float u_knee;

varying vec2 v_texcoord;

void main()
{
	vec2 o = u_sourceTexelSize;
	vec3 c = texture2D(u_texture, v_texcoord + vec2(-o.x, -o.y)).rgb
		+ texture2D(u_texture, v_texcoord + vec2(o.x, -o.y)).rgb
		+ texture2D(u_texture, v_texcoord + vec2(-o.x, o.y)).rgb
		+ texture2D(u_texture, v_texcoord + vec2(o.x, o.y)).rgb;
	c *= 0.25;
	float brightness = max(c.r, max(c.g, c.b));
	// soft knee：阈值附近平滑过渡
	float soft = clamp(brightness - u_threshold + u_knee, 0.0, 2.0 * u_knee);
	soft = soft * soft / (4.0 * u_knee + 0.0001);
	float contribution = max(soft, brightness - u_threshold) / max(brightness, 0.0001);
	gl_FragColor = vec4(c * contribution, 1.0);
}
